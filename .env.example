# Copy to .env and fill in. Never commit .env (keys stay backend-only,
# the Vite frontend on :5173 never sees them).
# Pure Ollama-only backend: no cloud LLM keys. Ollama down = loud 500.
ENHANCE_DEADLINE_S=600
# Ollama (company GPU server, RTX 5090). OLLAMA_URL is mandatory —
# auto mode means Ollama. No fallback provider exists.
# Laptop usage: ssh -L 11434:localhost:11434 aryan@vaultstackai  (then
# OLLAMA_URL=http://localhost:11434). On-server usage: OLLAMA_URL is already
# http://localhost:11434, no tunnel needed.
# LLM_PROVIDER=auto  (auto | ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=180
OLLAMA_MIN_SPACING_S=0
# Keep the model resident in VRAM across the 8 calls of a generate
# (avoids cold-reload per call; ignored if the server doesn't support it).
OLLAMA_KEEP_ALIVE=30m
# Section-enhance parallelism for Ollama (same prompts, only parallel).
# 2 is the agreed cap (validated on 24GB+ cards; server OLLAMA_NUM_PARALLEL
# must be >=2 or extra width just queues server-side). Voice+deal overlap
# with sections in the same 2-wide pool (draft-snapshot inputs, disjoint
# keys — identical outputs, ~55s saved).
OLLAMA_CONCURRENCY=2
#LLM_PROVIDER=auto
SEARXNG_URL=http://localhost:8081
FIRECRAWL_URL=http://localhost:3002
# Optional: comma-separated CORS origins for the API (defaults cover :5173/:3001/:4173).
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Optional: TMDB key for the title dataset; cache dir override.
# TMDB_API_KEY=
# DNA_CACHE_DIR=.cache
