# Copy to .env and fill in. Never commit .env (keys stay backend-only,
# the Vite frontend on :5173 never sees them).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback — leave on 120b unless you enabled another chat model at
# console.groq.com/settings/project/limits (20b is project-blocked on some accounts).
# 429-only fallback on a separate TPM bucket (primary stays 120b).
# Enable it once at console.groq.com -> settings -> project -> limits,
# else it 403s and the section keeps deterministic text (validator-gated).
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Optional pacing between Groq calls in seconds (default 2; higher = slower but fewer 429s).
GROQ_PACING_S=2
# Optional caps (seconds): per-429 wait inside groq_complete; enhance wall-clock;
# minimum spacing between Groq call starts (serial 1-wide anti-429).
GROQ_RETRY_AFTER_CAP=25
GROQ_MIN_SPACING_S=11
ENHANCE_DEADLINE_S=150
# Optional extra chat-model key (Groq takes priority when both are set).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Ollama-primary (company GPU server, RTX 5090). Set OLLAMA_URL to opt in —
# auto mode prefers Ollama when set, Groq/Anthropic stay as fallback.
# Laptop usage: ssh -L 11434:localhost:11434 aryan@vaultstackai  (then
# OLLAMA_URL=http://localhost:11434). On-server usage: OLLAMA_URL is already
# http://localhost:11434, no tunnel needed.
# LLM_PROVIDER=auto  (auto | ollama | groq | anthropic | deterministic)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=180
OLLAMA_MIN_SPACING_S=0
#LLM_PROVIDER=auto
SEARXNG_URL=http://localhost:8081
FIRECRAWL_URL=http://localhost:3002
# Optional: comma-separated CORS origins for the API (defaults cover :5173/:3001).
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional: TMDB key for the title dataset; cache dir override.
# TMDB_API_KEY=
# DNA_CACHE_DIR=.cache
